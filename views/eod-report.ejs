<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>9:15 EOD Report</title>
<style>
  :root{
    --green-bg:#dcf5e3; --green-bg-hover:#cdf0d8; --green-badge:#1fa855;
    --red-bg:#fbdfe0; --red-bg-hover:#f9d0d2; --red-badge:#e0373f;
    --border:#e4e6ea; --muted:#6b7280; --text:#111318; --blue:#2563eb; --blue-hover:#1d4ed8;
  }
  *{box-sizing:border-box;}
  body{
    margin:0; background:#fff; color:var(--text);
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  }
  .wrap{max-width:1440px; margin:0 auto; padding:28px 32px 64px;}
  h1{font-size:28px; font-weight:800; margin:0 0 4px;}
  .subtitle{color:var(--muted); font-size:14px; margin:0 0 22px;}

  /* ---------- Filter card ---------- */
  .filter-card{
    background:#f9fafb; border:1px solid var(--border); border-radius:12px;
    padding:18px 20px; margin-bottom:18px;
  }
  .filter-grid{
    display:grid; grid-template-columns:repeat(auto-fill, minmax(140px, 1fr));
    gap:14px 16px; align-items:end;
  }
  .field{display:flex; flex-direction:column; gap:6px; min-width:0;}
  .field label{font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.04em; color:var(--muted);}
  .field input, .field select{
    border:1px solid var(--border); border-radius:8px; padding:10px 12px; font-size:14px;
    color:var(--text); background:#fff; width:100%;
  }
  .field input:focus, .field select:focus{outline:2px solid var(--blue); outline-offset:-1px;}
  .field.span-2{grid-column:span 2;}
  .field.checkbox-field{flex-direction:row; align-items:center; gap:8px; padding-bottom:10px;}
  .field.checkbox-field input[type="checkbox"]{width:16px; height:16px; margin:0; accent-color:var(--blue); cursor:pointer;}
  .field.checkbox-field label{margin:0; cursor:pointer;}
  .filter-actions{
    display:flex; flex-wrap:wrap; gap:10px; align-items:center;
    margin-top:16px; padding-top:16px; border-top:1px solid var(--border);
  }
  .filter-actions .spacer{flex:1;}

  .btn{
    background:var(--blue); color:#fff; border:none; padding:11px 24px; border-radius:8px;
    font-size:14px; font-weight:600; cursor:pointer; transition:background .15s;
  }
  .btn:hover{background:var(--blue-hover);}
  .btn:disabled{opacity:.55; cursor:not-allowed;}
  .btn.secondary{background:#fff; color:var(--blue); border:1px solid var(--blue);}
  .btn.secondary:hover{background:#eff4ff;}

  .status-line{font-size:14px; color:var(--muted); margin:0 0 20px;}
  .status-line.error{color:var(--red-badge); font-weight:600;}

  /* ---------- Summary strip / panels ---------- */
  .summary-strip{
    display:grid; grid-template-columns:repeat(auto-fit, minmax(150px, 1fr)); gap:0;
    margin-bottom:18px; font-size:13px; background:#fff; border:1px solid var(--border); border-radius:10px; overflow:hidden;
  }
  .summary-strip .item{padding:12px 16px; border-right:1px solid var(--border); border-bottom:1px solid var(--border);}
  .summary-strip .item b{font-size:16px; display:block; margin-top:3px; font-weight:700;}
  .summary-strip .pos{color:var(--green-badge);}
  .summary-strip .neg{color:var(--red-badge);}

  table{width:100%; border-collapse:collapse; font-size:13.5px; margin-bottom:8px; font-variant-numeric:tabular-nums;}
  thead th{
    text-align:left; padding:11px 12px; background:#f6f7f9; border-bottom:2px solid var(--border);
    font-weight:700; font-size:12px; text-transform:uppercase; letter-spacing:.03em; color:#374151;
    white-space:nowrap; position:sticky; top:0; z-index:1;
  }
  tbody td{padding:9px 12px; white-space:nowrap; border-bottom:1px solid rgba(0,0,0,0.05);}
  tbody tr.row-buy{background:var(--green-bg);}
  tbody tr.row-buy:hover{background:var(--green-bg-hover);}
  tbody tr.row-sell{background:var(--red-bg);}
  tbody tr.row-sell:hover{background:var(--red-bg-hover);}
  tbody tr.row-neutral{background:#f3f4f6;}
  tbody tr.row-neutral:hover{background:#eceef1;}
  .pnl-sign{display:inline-block; width:9px;}
  tbody tr.row-clickable{cursor:pointer;}
  tbody tr.row-clickable:hover{filter:brightness(0.97);}
  tbody tr.row-clickable td:first-child{font-weight:700;}

  a.symbol-link{color:#1a73c7; font-weight:600; text-decoration:underline; cursor:pointer;}
  a.symbol-link:hover{color:#0e5a9e;}

  .badge{
    display:inline-block; padding:5px 14px; border-radius:6px; font-size:12px; font-weight:700; color:#fff;
  }
  .badge.buy{background:var(--green-badge);}
  .badge.sell{background:var(--red-badge);}

  .exit-badge{
    display:inline-block; padding:3px 12px; border-radius:20px; font-size:11px; font-weight:700;
  }
  .exit-badge.target{background:#1fa855; color:#fff;}
  .exit-badge.stoploss{background:var(--red-badge); color:#fff;}
  .exit-badge.trailing{background:#d97706; color:#fff;}
  .exit-badge.eod{background:#e5e7eb; color:#6b7280;}

  .section-heading{
    font-size:16px; font-weight:800; margin:32px 0 12px; display:flex; align-items:center; gap:10px;
    text-transform:uppercase; letter-spacing:.03em; color:#374151;
  }
  .section-heading .hint{
    font-size:12px; font-weight:500; text-transform:none; letter-spacing:0; color:var(--muted);
  }
  .empty{padding:34px; text-align:center; color:var(--muted); font-size:14px;}
  .hidden{display:none !important;}

  .table-card{border:1px solid var(--border); border-radius:12px; overflow:hidden; background:#fff;}
  .table-scroll{overflow-x:auto; max-height:70vh;}
  .table-scroll table{margin-bottom:0;}

  .alloc-panel{
    display:grid; grid-template-columns:repeat(auto-fit, minmax(150px, 1fr)); gap:0;
    margin-bottom:16px; font-size:13px;
    background:#f6f8fb; border:1px solid var(--border); border-radius:10px; overflow:hidden;
  }
  .alloc-panel .item{padding:14px 16px; border-right:1px solid var(--border); border-bottom:1px solid var(--border);}
  .alloc-panel .item b{font-size:16px; display:block; margin-top:3px;}
  .alloc-panel .pos{color:var(--green-badge);}
  .alloc-panel .neg{color:var(--red-badge);}

  .range-summary{
    display:grid; grid-template-columns:repeat(auto-fit, minmax(150px, 1fr)); gap:0;
    margin-bottom:16px; font-size:13px;
    background:#eef4ff; border:1px solid #cddcfb; border-radius:10px; overflow:hidden;
  }
  .range-summary .item{padding:14px 16px; border-right:1px solid #cddcfb; border-bottom:1px solid #cddcfb;}
  .range-summary .item b{font-size:17px; display:block; margin-top:3px;}
  .range-summary .pos{color:var(--green-badge);}
  .range-summary .neg{color:var(--red-badge);}

  .spinner{
    width:14px; height:14px; border:2px solid rgba(37,99,235,0.25); border-top-color:var(--blue);
    border-radius:50%; display:inline-block; animation:spin .7s linear infinite; vertical-align:-2px; margin-right:8px;
  }
  @keyframes spin{to{transform:rotate(360deg);}}

  /* ---- AI chat panel ---- */
  /* Floating chat widget (fixed to bottom-right, like a normal site widget) */
  .chat-fab{
    position:fixed; bottom:24px; right:24px; z-index:1000;
    width:58px; height:58px; border-radius:50%; border:none; cursor:pointer;
    background:var(--blue); color:#fff; box-shadow:0 6px 18px rgba(0,0,0,0.22);
    display:flex; align-items:center; justify-content:center;
    transition:transform 0.15s ease;
  }
  .chat-fab:hover{transform:scale(1.06);}
  .chat-fab svg{width:26px; height:26px;}
  .chat-fab .fab-close-icon{display:none;}
  .chat-fab.open .fab-chat-icon{display:none;}
  .chat-fab.open .fab-close-icon{display:block;}
  .chat-fab-badge{
    position:absolute; top:-2px; right:-2px; width:14px; height:14px; border-radius:50%;
    background:#e0473e; border:2px solid #fff;
  }
  .chat-fab-badge.hidden{display:none;}

  .chat-panel{
    position:fixed; bottom:96px; right:24px; z-index:1000;
    width:380px; max-width:calc(100vw - 32px);
    max-height:min(600px, calc(100vh - 140px));
    border:1px solid var(--border); border-radius:14px; overflow:hidden;
    background:#fafbfc; box-shadow:0 12px 32px rgba(0,0,0,0.18);
    display:none; flex-direction:column;
  }
  .chat-panel.open{display:flex;}
  .chat-panel-header{
    padding:14px 16px; border-bottom:1px solid var(--border); background:#fff;
    display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:4px; flex:0 0 auto;
  }
  .chat-panel-header .title{font-weight:700; font-size:15px;}
  .chat-panel-header .disclaimer{font-size:11px; color:var(--muted); width:100%;}
  .chat-log{flex:1 1 auto; min-height:120px; overflow-y:auto; padding:14px 16px; display:flex; flex-direction:column; gap:12px;}
  .chat-empty{color:var(--muted); font-size:14px; padding:6px 2px;}
  .chat-msg{max-width:80%; padding:10px 14px; border-radius:12px; font-size:14px; line-height:1.5; white-space:pre-wrap;}
  .chat-msg.user{align-self:flex-end; background:var(--blue); color:#fff; border-bottom-right-radius:3px;}
  .chat-msg.assistant{align-self:flex-start; background:#eef1f5; color:var(--text); border-bottom-left-radius:3px;}
  .chat-msg.assistant.pending{color:var(--muted); font-style:italic;}
  .chat-msg.error{align-self:flex-start; background:var(--red-bg); color:#8a1f24;}
  .chat-input-row{
    display:flex; gap:8px; padding:12px 16px; border-top:1px solid var(--border); background:#fff; flex:0 0 auto;
  }
  .chat-input-row input{
    flex:1; border:1px solid var(--border); border-radius:8px; padding:10px 12px; font-size:14px; min-width:0;
  }
  .chat-input-row input:focus{outline:2px solid var(--blue); outline-offset:-1px;}
  .chat-input-row input:disabled{background:#f3f4f6;}
  .chat-suggestions{display:flex; flex-wrap:wrap; gap:8px; padding:0 16px 12px; flex:0 0 auto;}
  .chat-suggestion-btn{
    border:1px solid var(--border); background:#fff; color:var(--text); border-radius:20px;
    padding:6px 12px; font-size:12px; cursor:pointer;
  }
  .chat-suggestion-btn:hover{background:#eff4ff; border-color:var(--blue);}

  @media (max-width:480px){
    .chat-panel{ right:16px; left:16px; width:auto; bottom:88px; }
    .chat-fab{ right:16px; bottom:16px; }
  }

  /* ══════════════════════════════════════════════════════════════════
     MOBILE / RESPONSIVE — professional, touch-friendly layout for
     phones and small tablets. Table data itself is untouched; only
     layout, spacing and touch targets adapt below each breakpoint.
     ══════════════════════════════════════════════════════════════════ */
  @media (max-width: 900px){
    .wrap{padding:18px 14px 48px;}
    h1{font-size:21px;}
    .subtitle{font-size:12.5px; margin-bottom:16px;}

    .filter-card{padding:14px;}
    .filter-grid{grid-template-columns:repeat(2, 1fr); gap:10px 10px;}
    .field.span-2{grid-column:span 2;}
    .field label{font-size:10px;}
    .field input, .field select{padding:11px 10px; font-size:15px; /* 15px+ avoids iOS auto-zoom on focus */}

    .filter-actions{flex-direction:column; align-items:stretch; gap:8px;}
    .filter-actions .spacer{display:none;}
    .btn{width:100%; padding:13px 18px; font-size:15px;}

    .summary-strip, .alloc-panel, .range-summary{grid-template-columns:repeat(2, 1fr);}
    .summary-strip .item, .alloc-panel .item, .range-summary .item{padding:10px 12px;}
    .summary-strip .item b, .alloc-panel .item b, .range-summary .item b{font-size:15px;}

    .section-heading{font-size:13px; margin:22px 0 10px; flex-wrap:wrap;}

    /* Tables: keep native table markup (nothing to break), but make the
       horizontal scroll itself feel native/obvious on a phone, and pin
       the identifying first column (symbol/date) so it stays visible
       while the rest of the row scrolls underneath a thumb. */
    .table-scroll{
      max-height:none;
      -webkit-overflow-scrolling:touch;
      border-top:1px solid var(--border);
    }
    table{font-size:12.5px;}
    thead th{padding:9px 10px; font-size:10.5px;}
    tbody td{padding:8px 10px;}
    thead th:first-child, tbody td:first-child{
      position:sticky; left:0; z-index:2;
      box-shadow:2px 0 4px -2px rgba(0,0,0,0.15);
    }
    thead th:first-child{background:#f6f7f9; z-index:3;}
    tbody tr.row-buy td:first-child{background:var(--green-bg);}
    tbody tr.row-sell td:first-child{background:var(--red-bg);}
    tbody tr.row-neutral td:first-child{background:#f3f4f6;}

    /* Floating chat widget becomes a full-screen sheet on small
       screens instead of a small fixed-size panel that can overflow
       the viewport or sit half off-screen. */
    .chat-fab{width:52px; height:52px; bottom:16px; right:16px;}
    .chat-panel{
      right:0; left:0; bottom:0; top:0;
      width:100%; max-width:100%; max-height:100%;
      border-radius:0;
    }
  }

  @media (max-width: 480px){
    .filter-grid{grid-template-columns:1fr;}
    .field.span-2{grid-column:span 1;}
    .summary-strip, .alloc-panel, .range-summary{grid-template-columns:1fr 1fr;}
    h1{font-size:19px;}
  }

</style>
</head>
<body>
<%- include('partials/sidebar') %>
<div class="wrap">

  <h1>9:15 Back Testing Report</h1>
  <p class="subtitle">Default exit checkpoint: 3:06 PM. Pick a date, tune the filters, then run the report.</p>

  <div class="filter-card">
    <div class="filter-grid">
      <div class="field">
        <label for="date">Date</label>
        <input type="date" id="date" value="<%= defaultDate %>">
      </div>
      <div class="field">
        <label for="signalType">Signal</label>
        <select id="signalType">
          <option value="">All</option>
          <option value="BUY">Buy</option>
          <option value="SELL">Sell</option>
        </select>
      </div>
      <div class="field">
        <label for="broker">Broker data</label>
        <select id="broker" title="Which broker's historical 3-min candles to base this report on">
          <option value="fyers">Fyers</option>
          <option value="shoonya">Shoonya</option>
        </select>
      </div>
      <div class="field">
        <label for="topN">Top N stocks</label>
        <input type="number" id="topN" step="1" min="1" placeholder="Any" title="Keep only the N best-performing triggered signals (by profit %), after every other filter">
      </div>
      <div class="field">
        <label for="target">Target %</label>
        <input type="number" id="target" step="0.1" min="0" placeholder="e.g. 1">
      </div>
      <div class="field">
        <label for="stoploss">Stoploss %</label>
        <input type="number" id="stoploss" step="0.1" min="0" placeholder="e.g. 0.5">
      </div>
      <div class="field checkbox-field">
        <input type="checkbox" id="trailingSL">
        <label for="trailingSL">Trailing Stop Loss</label>
      </div>
      <div class="field hidden" id="trailingPercentField">
        <label for="trailingPercent">Trailing SL %</label>
        <input type="number" id="trailingPercent" step="0.1" min="0" placeholder="e.g. 1" title="Stop loss trails the best price seen since entry by this %">
      </div>
      <div class="field">
        <label for="rangeMin">Min price</label>
        <input type="number" id="rangeMin" step="0.5" min="0" placeholder="Any">
      </div>
      <div class="field">
        <label for="rangeMax">Max price</label>
        <input type="number" id="rangeMax" step="0.5" min="0" placeholder="Any">
      </div>
      <div class="field">
        <label for="ratioMin">Min ratio</label>
        <input type="number" id="ratioMin" step="0.1" min="0" placeholder="Any">
      </div>
      <div class="field">
        <label for="ratioMax">Max ratio</label>
        <input type="number" id="ratioMax" step="0.1" min="0" placeholder="Any">
      </div>
      <div class="field">
        <label for="exitTime">Custom exit time</label>
        <input type="time" id="exitTime" title="Exit all trades at this time instead — shows the resulting P/L">
      </div>
      <div class="field">
        <label for="balance">Balance (₹)</label>
        <input type="number" id="balance" step="1000" min="0" placeholder="e.g. 100000" title="Split this cash equally across every signal (triggered or not)">
      </div>
      <div class="field">
        <label for="brokeragePerTrade">Brokerage per trade (₹, round-trip)</label>
        <input type="number" id="brokeragePerTrade" step="0.5" min="0" placeholder="e.g. 10" title="Buy leg + sell leg combined — e.g. Shoonya charges ₹5 to buy + ₹5 to sell = ₹10 per completed trade">
      </div>
      <div class="field">
        <label for="period">Simulate over</label>
        <select id="period" title="Simulate this balance over a single day, a week, a month, or any custom range">
          <option value="day">Single day</option>
          <option value="week">This Week</option>
          <option value="month">This Month</option>
          <option value="custom">Custom range...</option>
        </select>
      </div>
      <div class="field hidden" id="rangeStartField">
        <label for="rangeStart">From</label>
        <input type="date" id="rangeStart" title="From date">
      </div>
      <div class="field hidden" id="rangeEndField">
        <label for="rangeEnd">To</label>
        <input type="date" id="rangeEnd" title="To date">
      </div>
    </div>

    <div class="filter-actions">
      <button class="btn" id="generateBtn">Search</button>
      <span class="spacer"></span>
      <div class="field" style="min-width:130px;">
        <label for="downloadFormat">Format</label>
        <select id="downloadFormat">
          <option value="txt">.txt</option>
          <option value="xlsx">.xlsx (Excel)</option>
        </select>
      </div>
      <button class="btn secondary" id="downloadBtn" style="align-self:flex-end;">Download</button>
    </div>
  </div>

  <div class="status-line" id="statusLine">Pick a date (and optionally a target / stoploss %), then click Search.</div>

  <div id="summaryStrip" class="summary-strip"></div>

  <div id="resultsMeta" class="status-line" style="margin-bottom:14px;"></div>

  <!-- Single-day view (default) -->
  <div id="dayView">
    <button class="btn secondary hidden" id="backToRangeBtn" style="margin-bottom:16px;">&larr; Back to week/month report</button>

    <div id="allocationSection" class="hidden">
      <div class="section-heading">Capital Allocation</div>
      <div id="allocPanel" class="alloc-panel"></div>
      <div class="table-card">
        <div class="table-scroll">
          <table id="allocTable">
            <thead><tr>
              <th>Symbol</th><th>Signal</th><th>Triggered</th><th>Entry</th><th>Allocated ₹</th><th>Qty</th>
              <th>Used ₹</th><th>Unused ₹</th><th>P&amp;L ₹</th>
            </tr></thead>
            <tbody></tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="section-heading">Signals <span class="hint">— exit column reflects the 3:06 PM default exit unless target/stoploss/custom exit hit first</span></div>
    <div class="table-card">
      <div class="table-scroll">
        <table id="mainTable">
          <thead></thead>
          <tbody><tr><td class="empty">No report generated yet.</td></tr></tbody>
        </table>
      </div>
    </div>

    <div id="noDataSection" class="hidden">
      <div class="section-heading">Not entered / no data</div>
      <div class="table-card">
        <div class="table-scroll">
          <table id="noDataTable">
            <thead><tr><th>Symbol</th><th>Signal</th><th>Ratio</th><th>Reason</th></tr></thead>
            <tbody></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- Week / month simulation view -->
  <div id="rangeView" class="hidden">
    <div id="rangeSummary" class="range-summary"></div>
    <div class="section-heading">Day-by-day <span class="hint">— click a row to open that day's full report</span></div>
    <div class="table-card">
      <div class="table-scroll">
        <table id="rangeTable">
          <thead><tr>
            <th>Date</th><th>Triggered</th><th>Start Balance ₹</th><th>Allocated ₹</th>
            <th>Unused ₹</th><th>P&amp;L ₹</th><th>Return %</th><th>End Balance ₹</th>
          </tr></thead>
          <tbody></tbody>
        </table>
      </div>
    </div>
  </div>

</div>

<!-- Floating chat widget -->
<div class="chat-panel" id="chatPanel">
  <div class="chat-panel-header">
    <div class="title">AI Q&amp;A</div>
    <div class="disclaimer">Answers are generated from the report data above only — not investment advice.</div>
  </div>
  <div class="chat-log" id="chatLog">
    <div class="chat-empty" id="chatEmpty">Generate a report above, then ask things like "which BUY had the best profit%?" or "how many hit stoploss?"</div>
  </div>
  <div class="chat-suggestions hidden" id="chatSuggestions"></div>
  <div class="chat-input-row">
    <input type="text" id="chatInput" placeholder="Generate a report first..." disabled>
    <button class="btn" id="chatSendBtn" disabled>Ask</button>
  </div>
</div>

<button class="chat-fab" id="chatFab" title="Ask about this report" aria-label="Open AI Q&amp;A chat">
  <svg class="fab-chat-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M4 4h16v12H7l-3 3V4z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
  </svg>
  <svg class="fab-close-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
  </svg>
  <span class="chat-fab-badge hidden" id="chatFabBadge"></span>
</button>

<script>
const dateInput = document.getElementById('date');
const signalTypeInput = document.getElementById('signalType');
const brokerInput = document.getElementById('broker');
const topNInput = document.getElementById('topN');
const targetInput = document.getElementById('target');
const stoplossInput = document.getElementById('stoploss');
const trailingSLInput = document.getElementById('trailingSL');
const trailingPercentInput = document.getElementById('trailingPercent');
const rangeMinInput = document.getElementById('rangeMin');
const rangeMaxInput = document.getElementById('rangeMax');
const ratioMinInput = document.getElementById('ratioMin');
const ratioMaxInput = document.getElementById('ratioMax');
const exitTimeInput = document.getElementById('exitTime');
const balanceInput = document.getElementById('balance');
const periodSelect = document.getElementById('period');
const rangeStartInput = document.getElementById('rangeStart');
const rangeEndInput = document.getElementById('rangeEnd');
const downloadFormatSelect = document.getElementById('downloadFormat');
const generateBtn = document.getElementById('generateBtn');
const downloadBtn = document.getElementById('downloadBtn');
const statusLine = document.getElementById('statusLine');
const summaryStrip = document.getElementById('summaryStrip');
const resultsMeta = document.getElementById('resultsMeta');
const mainTable = document.getElementById('mainTable');
const noDataSection = document.getElementById('noDataSection');
const noDataTable = document.getElementById('noDataTable');
const dayView = document.getElementById('dayView');
const rangeView = document.getElementById('rangeView');
const allocationSection = document.getElementById('allocationSection');
const allocPanel = document.getElementById('allocPanel');
const allocTable = document.getElementById('allocTable');
const rangeSummary = document.getElementById('rangeSummary');
const rangeTable = document.getElementById('rangeTable');
const backToRangeBtn = document.getElementById('backToRangeBtn');

// Remembers the last week/month simulation so "Back to week/month report"
// can restore it without re-running the whole simulation.
let lastRangeState = null; // { period, result }

const dateField = dateInput.closest('.field');
const rangeStartField = document.getElementById('rangeStartField');
const rangeEndField = document.getElementById('rangeEndField');

function updatePeriodFieldsVisibility() {
  const isCustom = periodSelect.value === 'custom';
  dateField.classList.toggle('hidden', isCustom);
  rangeStartField.classList.toggle('hidden', !isCustom);
  rangeEndField.classList.toggle('hidden', !isCustom);
}
periodSelect.addEventListener('change', updatePeriodFieldsVisibility);
updatePeriodFieldsVisibility();

// Trailing Stop Loss: checking the box reveals the custom % field and
// disables the fixed Stoploss % field, since trailing SL replaces the
// fixed stoploss for exit purposes (target % still applies alongside it).
const trailingPercentField = document.getElementById('trailingPercentField');
function updateTrailingSLVisibility() {
  const enabled = trailingSLInput.checked;
  trailingPercentField.classList.toggle('hidden', !enabled);
  stoplossInput.disabled = enabled;
  stoplossInput.placeholder = enabled ? 'Replaced by trailing SL' : 'e.g. 0.5';
  if (enabled) stoplossInput.value = '';
}
trailingSLInput.addEventListener('change', updateTrailingSLVisibility);
updateTrailingSLVisibility();

// AI chat panel elements/state
const chatLog = document.getElementById('chatLog');
const chatEmpty = document.getElementById('chatEmpty');
const chatSuggestions = document.getElementById('chatSuggestions');
const chatInput = document.getElementById('chatInput');
const chatSendBtn = document.getElementById('chatSendBtn');
const chatFab = document.getElementById('chatFab');
const chatFabBadge = document.getElementById('chatFabBadge');
const chatPanel = document.getElementById('chatPanel');

function openChatPanel() {
  chatPanel.classList.add('open');
  chatFab.classList.add('open');
  chatFabBadge.classList.add('hidden');
  if (!chatInput.disabled) chatInput.focus();
}
function closeChatPanel() {
  chatPanel.classList.remove('open');
  chatFab.classList.remove('open');
}
chatFab.addEventListener('click', () => {
  chatPanel.classList.contains('open') ? closeChatPanel() : openChatPanel();
});
let lastReport = null; // most recently generated single-day report
let chatMode = 'day'; // 'day' | 'range' — which one chat questions get sent against
let chatHistory = []; // [{role:'user'|'assistant', content:string}, ...]

const DAY_SUGGESTIONS = [
  { q: 'What was the best performing signal today?', label: 'Best performer?' },
  { q: 'How many signals hit stoploss vs target?', label: 'Target vs stoploss?' },
  { q: "Summarize today's report in a few sentences.", label: 'Summarize today' },
  { q: 'Which signals never triggered and why?', label: 'Non-triggered signals?' }
];
const RANGE_SUGGESTIONS = [
  { q: 'Which day performed best and which performed worst?', label: 'Best/worst day?' },
  { q: 'How many days were profitable vs losing days?', label: 'Profit vs loss days?' },
  { q: 'Summarize this simulation in a few sentences.', label: 'Summarize period' },
  { q: 'How did the balance grow over the period?', label: 'Balance growth?' }
];

function renderChatSuggestions(mode) {
  const list = mode === 'range' ? RANGE_SUGGESTIONS : DAY_SUGGESTIONS;
  chatSuggestions.innerHTML = list
    .map(s => `<button class="chat-suggestion-btn" data-q="${s.q.replace(/"/g, '&quot;')}">${s.label}</button>`)
    .join('');
}

// Resets the chat panel/history whenever a NEW report or simulation is
// generated — old answers referred to whatever filters/date/period was
// active before, so they shouldn't carry over.
function resetChatPanel(mode, { hasData, emptyText, placeholder }) {
  chatMode = mode;
  chatHistory = [];
  chatLog.innerHTML = '';
  chatEmpty.textContent = emptyText;
  chatLog.appendChild(chatEmpty);
  chatEmpty.classList.remove('hidden');
  chatInput.disabled = !hasData;
  chatSendBtn.disabled = !hasData;
  chatInput.placeholder = hasData ? placeholder : 'Nothing to ask about yet';
  renderChatSuggestions(mode);
  chatSuggestions.classList.toggle('hidden', !hasData);

  if (hasData && !chatPanel.classList.contains('open')) {
    chatFabBadge.classList.remove('hidden');
  } else {
    chatFabBadge.classList.add('hidden');
  }
}

function fmtPct(n) {
  if (n === null || n === undefined) return '-';
  return n.toFixed(2) + '%';
}

function fmtRatio(n) {
  if (n === null || n === undefined || typeof n !== 'number') return '-';
  return n.toFixed(2) + 'x';
}

function buildQuery() {
  const params = new URLSearchParams();
  if (periodSelect.value === 'custom') {
    params.set('startDate', rangeStartInput.value);
    params.set('endDate', rangeEndInput.value);
  } else {
    params.set('date', dateInput.value);
  }
  if (signalTypeInput.value !== '') params.set('signalType', signalTypeInput.value);
  if (brokerInput.value !== '') params.set('broker', brokerInput.value);
  if (topNInput.value !== '') params.set('topN', topNInput.value);
  if (targetInput.value !== '') params.set('target', targetInput.value);
  if (stoplossInput.value !== '') params.set('stoploss', stoplossInput.value);
  if (rangeMinInput.value !== '') params.set('rangeMin', rangeMinInput.value);
  if (rangeMaxInput.value !== '') params.set('rangeMax', rangeMaxInput.value);
  if (ratioMinInput.value !== '') params.set('ratioMin', ratioMinInput.value);
  if (ratioMaxInput.value !== '') params.set('ratioMax', ratioMaxInput.value);
  if (exitTimeInput.value !== '') params.set('exitTime', exitTimeInput.value);
  if (balanceInput.value !== '') params.set('balance', balanceInput.value);
  if (trailingSLInput.checked) {
    params.set('trailingSL', 'true');
    if (trailingPercentInput.value !== '') params.set('trailingPercent', trailingPercentInput.value);
  }
  return params.toString();
}

function fmtMoney(n) {
  if (n === null || n === undefined || typeof n !== 'number') return '-';
  return (n < 0 ? '-' : '') + '\u20b9' + Math.abs(n).toFixed(2);
}

// Same as fmtMoney but with the leading +/-/(nothing) rendered in a fixed-width
// slot, so a run of rows mixing "+₹362.00", "-₹656.65" and "₹0.00" all line up
// on the ₹ instead of the zero row's amount sitting one character to the left.
function fmtSignedMoney(n) {
  if (n === null || n === undefined || typeof n !== 'number') return '-';
  const sign = n > 0 ? '+' : (n < 0 ? '-' : '');
  return `<span class="pnl-sign">${sign}</span>\u20b9${Math.abs(n).toFixed(2)}`;
}

function tvLink(symbol) {
  return `https://www.tradingview.com/chart/?symbol=NSE:${symbol}`;
}

function renderSummary(report) {
  const s = report.summary;
  const brokeragePerTrade = Number(document.getElementById('brokeragePerTrade').value) || 0;
  const totalBrokerage = brokeragePerTrade * s.triggeredCount;
  const netAfterBrokerage = s.netMoney - totalBrokerage;
  const parts = [
    `<div class="item">Signals: <b>${s.totalSymbolsProcessed}</b></div>`,
    `<div class="item">Triggered: <b>${s.triggeredCount}</b></div>`,
    `<div class="item">Total P/L %: <b class="${s.totalProfitPercent >= 0 ? 'pos' : 'neg'}">${fmtPct(s.totalProfitPercent)}</b></div>`,
    `<div class="item">Net: <b class="${s.isNetProfit ? 'pos' : 'neg'}">${s.isNetProfit ? '+' : '-'}\u20b9${Math.abs(s.netMoney).toFixed(2)}</b> (${fmtPct(s.netReturnPercent)} on capital)</div>`,
    `<div class="item">Capital required: <b>\u20b9${s.totalCapitalRequired.toFixed(2)}</b></div>`,
  ];
  if (s.avgBestPossiblePercent !== null && s.avgBestPossiblePercent !== undefined) {
    parts.push(`<div class="item">Avg Best Possible %: <b class="pos">${fmtPct(s.avgBestPossiblePercent)}</b></div>`);
  }
  if (brokeragePerTrade > 0) {
    parts.push(`<div class="item">Brokerage: <b class="neg">-\u20b9${totalBrokerage.toFixed(2)}</b> (${s.triggeredCount} trades \u00d7 \u20b9${brokeragePerTrade.toFixed(2)})</div>`);
    parts.push(`<div class="item">Net after brokerage: <b class="${netAfterBrokerage >= 0 ? 'pos' : 'neg'}">${netAfterBrokerage >= 0 ? '+' : '-'}\u20b9${Math.abs(netAfterBrokerage).toFixed(2)}</b></div>`);
  }
  if (report.target !== null) parts.push(`<div class="item">Target ${report.target}% hit: <b class="pos">${s.targetHitCount}</b> / ${s.triggeredCount}</div>`);
  if (report.stoploss !== null) parts.push(`<div class="item">Stoploss ${report.stoploss}% hit: <b class="neg">${s.stoplossHitCount}</b> / ${s.triggeredCount}</div>`);
  if (report.trailingSL) parts.push(`<div class="item">Trailing SL ${report.trailingPercent}% hit: <b class="neg">${s.trailingStoplossHitCount}</b> / ${s.triggeredCount}</div>`);
  if (report.rangeMin !== null || report.rangeMax !== null) {
    parts.push(`<div class="item">Price range: <b>${report.rangeMin ?? 'any'} - ${report.rangeMax ?? 'any'}</b></div>`);
  }
  if (report.signalType) {
    parts.push(`<div class="item">Signal: <b>${report.signalType}</b></div>`);
  }
  if (report.broker) {
    parts.push(`<div class="item">Broker data: <b>${report.broker === 'shoonya' ? 'Shoonya' : 'Fyers'}</b></div>`);
  }
  if (report.topN) {
    parts.push(`<div class="item">Top N stocks: <b>${report.topN}</b></div>`);
  }
  if (report.ratioMin !== null || report.ratioMax !== null) {
    parts.push(`<div class="item">Ratio range: <b>${report.ratioMin ?? 'any'}x - ${report.ratioMax ?? 'any'}x</b></div>`);
  }
  if (report.exitTime && s.customExitCount > 0) {
    parts.push(`<div class="item">If exited @ ${report.exitTime}: <b class="${s.isNetProfitCustom ? 'pos' : 'neg'}">${fmtPct(s.totalProfitPercentCustom)}</b> / <b class="${s.isNetProfitCustom ? 'pos' : 'neg'}">${s.isNetProfitCustom ? '+' : '-'}\u20b9${Math.abs(s.netMoneyCustom).toFixed(2)}</b> (${fmtPct(s.netReturnPercentCustom)} on capital, ${s.customExitCount}/${s.triggeredCount} priced)</div>`);
  } else if (report.exitTime) {
    parts.push(`<div class="item">If exited @ ${report.exitTime}: <b class="neg">no candle data at/after this time</b></div>`);
  }
  summaryStrip.innerHTML = parts.join('');
}

function rowClass(signal) {
  return signal === 'BUY' ? 'row-buy' : 'row-sell';
}

function exitBadge(s) {
  if (s.exitReason === 'target') return '<span class="exit-badge target">TARGET</span>';
  if (s.exitReason === 'trailing_stoploss') return '<span class="exit-badge trailing">TRAILING SL</span>';
  if (s.exitReason === 'stoploss') return '<span class="exit-badge stoploss">STOPLOSS</span>';
  return '<span class="exit-badge eod">EOD (3:06)</span>';
}

function renderMainTable(rows, hasTargetOrSl, hasCustomExit, exitTimeLabel) {
  const thead = mainTable.querySelector('thead');
  const tbody = mainTable.querySelector('tbody');
  const colCount = 11 + (hasTargetOrSl ? 1 : 0) + (hasCustomExit ? 2 : 0);

  thead.innerHTML = `<tr>
    <th>Symbol</th><th>Signal</th><th>Ratio</th><th>Entry</th><th>Exit</th>
    ${hasTargetOrSl ? '<th>Exit Via</th>' : ''}
    <th>3:06 LTP</th><th>3:06 Profit %</th>
    <th>Profit %</th><th>Best Possible %</th><th>Worst Dip %</th>
    ${hasCustomExit ? `<th>${exitTimeLabel} LTP</th><th>${exitTimeLabel} Profit %</th>` : ''}
  </tr>`;

  if (rows.length === 0) {
    tbody.innerHTML = `<tr><td class="empty" colspan="${colCount}">No triggered signals for this date.</td></tr>`;
    return;
  }

  tbody.innerHTML = rows.map(s => `
    <tr class="${rowClass(s.signal)}">
      <td><a class="symbol-link" href="${tvLink(s.symbol)}" target="_blank">${s.symbol}</a></td>
      <td><span class="badge ${s.signal === 'BUY' ? 'buy' : 'sell'}">${s.signal}</span></td>
      <td>${fmtRatio(s.ratio)}</td>
      <td>${s.entryPrice}</td>
      <td>${s.exitPrice}</td>
      ${hasTargetOrSl ? `<td>${exitBadge(s)}</td>` : ''}
      <td>${s.ltp310 ?? '-'}</td>
      <td>${fmtPct(s.ltp310Percent)}</td>
      <td>${fmtPct(s.profitPercent)}</td>
      <td>${fmtPct(s.high)}</td>
      <td>${fmtPct(s.low)}</td>
      ${hasCustomExit ? `<td>${s.ltpCustom ?? '-'}</td><td>${fmtPct(s.customPercent)}</td>` : ''}
    </tr>
  `).join('');
}

function renderNoData(group) {
  if (group.length === 0) {
    noDataSection.classList.add('hidden');
    return;
  }
  noDataSection.classList.remove('hidden');
  noDataTable.querySelector('tbody').innerHTML = group.map(f => `
    <tr class="row-neutral">
      <td><a class="symbol-link" href="${tvLink(f.symbol)}" target="_blank">${f.symbol}</a></td>
      <td><span class="badge ${f.signal === 'BUY' ? 'buy' : 'sell'}">${f.signal}</span></td>
      <td>${fmtRatio(f.ratio)}</td>
      <td>${f.reason}</td>
    </tr>
  `).join('');
}

function renderAllocation(allocation) {
  if (!allocation) {
    allocationSection.classList.add('hidden');
    return;
  }
  allocationSection.classList.remove('hidden');

  const pnlClass = allocation.totalPnl === 0 ? '' : (allocation.totalPnl > 0 ? 'pos' : 'neg');
  const parts = [
    `<div class="item">Starting balance<b>${fmtMoney(allocation.startBalance)}</b></div>`,
    `<div class="item">Per-signal allocation (${allocation.signalCount} signals, ${allocation.triggeredCount} triggered)<b>${fmtMoney(allocation.perSignalAllocation)}</b></div>`,
    `<div class="item">Used<b>${fmtMoney(allocation.totalUsed)}</b></div>`,
    `<div class="item">Unused (leftover)<b>${fmtMoney(allocation.totalUnused)}</b></div>`,
    `<div class="item">P&amp;L<b class="${pnlClass}">${fmtSignedMoney(allocation.totalPnl)} (${fmtPct(allocation.returnPercent)})</b></div>`,
    `<div class="item">Ending balance<b class="${pnlClass}">${fmtMoney(allocation.endingBalance)}</b></div>`,
  ];
  if (allocation.exitTimeApplied) {
    parts.push(`<div class="item">Exit used<b>${allocation.exitTimeApplied} (${allocation.customExitAppliedCount}/${allocation.triggeredCount} trades)</b></div>`);
  }
  if (allocation.skippedNoQty > 0) {
    parts.push(`<div class="item">Too small to buy 1 share<b class="neg">${allocation.skippedNoQty}</b></div>`);
  }
  allocPanel.innerHTML = parts.join('');

  allocTable.querySelector('tbody').innerHTML = allocation.detail
    .slice()
    .sort((a, b) => {
      if (a.triggered !== b.triggered) return a.triggered ? -1 : 1; // triggered rows first
      return b.pnl - a.pnl;
    })
    .map(d => `
      <tr class="${d.triggered ? rowClass(d.signal) : 'row-neutral'}">
        <td><a class="symbol-link" href="${tvLink(d.symbol)}" target="_blank">${d.symbol}</a></td>
        <td><span class="badge ${d.signal === 'BUY' ? 'buy' : 'sell'}">${d.signal}</span></td>
        <td>${d.triggered ? '<span style="color:var(--green-badge);font-weight:700;">Yes</span>' : '<span style="color:var(--muted);">No</span>'}</td>
        <td>${d.entryPrice ?? '-'}</td>
        <td>${fmtMoney(d.allocated)}</td>
        <td>${d.qty}</td>
        <td>${fmtMoney(d.used)}</td>
        <td>${fmtMoney(d.unused)}</td>
        <td class="${!d.triggered || d.pnl === 0 ? '' : (d.pnl > 0 ? 'pos' : 'neg')}" style="font-weight:700;">${d.triggered ? fmtSignedMoney(d.pnl) : '-'}</td>
      </tr>
    `).join('');
}

function render(report) {
  dayView.classList.remove('hidden');
  rangeView.classList.add('hidden');
  if (report.noSignals) {
    summaryStrip.innerHTML = '';
    resultsMeta.textContent = `0 result(s) for ${report.dateStr}`;
    mainTable.querySelector('thead').innerHTML = '';
    mainTable.querySelector('tbody').innerHTML = `<tr><td class="empty">No signals found for this date.</td></tr>`;
    noDataSection.classList.add('hidden');
    renderAllocation(null);
    return;
  }

  const hasTargetOrSl = report.target !== null || report.stoploss !== null;
  const hasCustomExit = Boolean(report.exitTime);

  // Single combined, sorted-by-profit table (successful + failed-with-data),
  // matching the screener's "one table, colored by signal" layout.
  const allTriggered = report.successful.concat(report.failed.filter(f => typeof f.profitPercent === 'number'));
  allTriggered.sort((a, b) => b.profitPercent - a.profitPercent);

  renderSummary(report);
  resultsMeta.textContent = `${allTriggered.length} triggered signal(s) for ${report.dateStr}`;
  renderMainTable(allTriggered, hasTargetOrSl, hasCustomExit, report.exitTime);
  renderNoData(report.failedNoData);
  renderAllocation(report.allocation);
}

function renderRange(period, result) {
  dayView.classList.add('hidden');
  rangeView.classList.remove('hidden');
  summaryStrip.innerHTML = '';
  lastRangeState = { period, result };

  const label = period === 'week' ? 'week' : 'month';
  const exitNote = result.exitTime ? ` — simulated as if every trade exited at ${result.exitTime}` : '';
  resultsMeta.textContent = `${result.tradingDaysCount} trading day(s) with signals out of ${result.totalDaysChecked} weekday(s) in this ${label} (${result.startDate} \u2192 ${result.endDate})${exitNote}`;

  const pnlClass = result.totalPnl === 0 ? '' : (result.totalPnl > 0 ? 'pos' : 'neg');
  const totalTriggeredInRange = result.days.reduce((sum, d) => sum + (d.triggeredCount || 0), 0);
  const brokeragePerTrade = Number(document.getElementById('brokeragePerTrade').value) || 0;
  const totalBrokerage = brokeragePerTrade * totalTriggeredInRange;
  const pnlAfterBrokerage = result.totalPnl - totalBrokerage;

  const summaryItems = [
    `<div class="item">Period<b>${result.startDate} \u2192 ${result.endDate}</b></div>`,
    `<div class="item">Starting balance<b>${fmtMoney(result.startBalance)}</b></div>`,
    `<div class="item">Ending balance<b class="${pnlClass}">${fmtMoney(result.endBalance)}</b></div>`,
    `<div class="item">Total P&amp;L<b class="${pnlClass}">${fmtSignedMoney(result.totalPnl)} (${fmtPct(result.totalReturnPercent)})</b></div>`,
    `<div class="item">Profit / Loss days<b><span class="pos">${result.profitDays}</span> / <span class="neg">${result.lossDays}</span></b></div>`,
  ];
  if (result.avgBestPossiblePercent !== null && result.avgBestPossiblePercent !== undefined) {
    summaryItems.push(`<div class="item">Avg Best Possible %<b class="pos">${fmtPct(result.avgBestPossiblePercent)}</b></div>`);
  }
  if (brokeragePerTrade > 0) {
    summaryItems.push(`<div class="item">Brokerage<b class="neg">-${fmtMoney(totalBrokerage)} (${totalTriggeredInRange} trades \u00d7 \u20b9${brokeragePerTrade.toFixed(2)})</b></div>`);
    summaryItems.push(`<div class="item">P&amp;L after brokerage<b class="${pnlAfterBrokerage === 0 ? '' : (pnlAfterBrokerage > 0 ? 'pos' : 'neg')}">${fmtSignedMoney(pnlAfterBrokerage)}</b></div>`);
  }
  rangeSummary.innerHTML = summaryItems.join('');

  rangeTable.querySelector('tbody').innerHTML = result.days.map(d => {
    // A day can genuinely close at exactly ₹0.00 P&L (e.g. a trade that
    // triggered but exited flat) — that's neither a win nor a loss, so it
    // should render neutral (white/grey), not green or red.
    const rowVariant = d.noSignals || d.pnl === 0 ? 'row-neutral' : (d.pnl > 0 ? 'row-buy' : 'row-sell');
    const pnlClass = d.noSignals ? '' : (d.pnl === 0 ? '' : (d.pnl > 0 ? 'pos' : 'neg'));
    return `
    <tr class="row-clickable ${rowVariant}" data-date="${d.dateStr}" title="Open the full report for ${d.dateStr}">
      <td>${d.dateStr}</td>
      <td>${d.triggeredCount}</td>
      <td>${fmtMoney(d.startBalance)}</td>
      <td>${fmtMoney(d.allocated)}</td>
      <td>${fmtMoney(d.unused)}</td>
      <td style="font-weight:700;" class="${pnlClass}">${d.noSignals ? '-' : fmtSignedMoney(d.pnl)}</td>
      <td>${d.noSignals ? '-' : fmtPct(d.returnPercent)}</td>
      <td>${fmtMoney(d.endBalance)}</td>
    </tr>
  `;
  }).join('');

  rangeTable.querySelectorAll('tbody tr[data-date]').forEach(row => {
    row.addEventListener('click', () => openDayFromRange(row.getAttribute('data-date')));
  });

  const periodLabel = period === 'week' ? 'this week' : period === 'month' ? 'this month' : 'this custom range';
  resetChatPanel('range', {
    hasData: result.tradingDaysCount > 0,
    emptyText: result.tradingDaysCount > 0
      ? `Ask a question about ${periodLabel}'s simulation below.`
      : `No triggered signals in ${periodLabel}, so there's nothing to ask about yet.`,
    placeholder: 'e.g. Which was the most profitable day?'
  });
}

// Clicking a Day-by-day row drops back into the Single day view, pre-filled
// with that date, and immediately runs the report for it (keeping whatever
// signal/target/stoploss/price/ratio filters are already set).
async function openDayFromRange(dateStr) {
  periodSelect.value = 'day';
  updatePeriodFieldsVisibility();
  dateInput.value = dateStr;

  // IMPORTANT: the range/month simulation compounds the balance day to
  // day (each day starts with the PREVIOUS day's ending balance, not the
  // flat number typed into the Balance field). If we leave balanceInput
  // as-is, this single-day re-run allocates capital using the ORIGINAL
  // flat balance instead of that day's actual compounded starting
  // balance — a different per-signal allocation changes the floor()'d
  // share qty, which silently changes P&L vs. what the month table shows
  // for the same day. Look up that day's real startBalance from the
  // range result we already have and use it for this one re-run, then
  // restore the form's original value so the top-level Balance field
  // still reflects what the user typed for week/month simulations.
  const dayRow = lastRangeState?.result?.days?.find(d => d.dateStr === dateStr);
  const originalBalanceValue = balanceInput.value;
  if (dayRow && !dayRow.noSignals) {
    balanceInput.value = dayRow.startBalance;
  }

  await generateReport();

  balanceInput.value = originalBalanceValue;

  backToRangeBtn.classList.remove('hidden');
  dayView.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

// Restores the week/month simulation that was showing before the user
// clicked into a specific day, without re-running it.
function backToRange() {
  if (!lastRangeState) return;
  renderRange(lastRangeState.period, lastRangeState.result);
  const label = lastRangeState.period === 'week' ? 'week' : lastRangeState.period === 'month' ? 'month' : 'range';
  periodSelect.value = lastRangeState.period === 'custom' ? 'custom' : lastRangeState.period;
  updatePeriodFieldsVisibility();
  statusLine.classList.remove('error');
  statusLine.textContent = `Simulation ready for ${lastRangeState.result.startDate} \u2192 ${lastRangeState.result.endDate}.`;
  rangeView.scrollIntoView({ behavior: 'smooth', block: 'start' });
}
backToRangeBtn.addEventListener('click', backToRange);

async function generateReport() {
  const period = periodSelect.value;
  backToRangeBtn.classList.add('hidden');

  if (period === 'custom') {
    if (!rangeStartInput.value || !rangeEndInput.value) {
      statusLine.textContent = 'Pick both a "From" and "To" date for the custom range.';
      statusLine.classList.add('error');
      return;
    }
    if (rangeStartInput.value > rangeEndInput.value) {
      statusLine.textContent = '"From" date must be on or before "To" date.';
      statusLine.classList.add('error');
      return;
    }
  } else if (!dateInput.value) {
    statusLine.textContent = 'Please pick a date first.';
    statusLine.classList.add('error');
    return;
  }

  if (period !== 'day') {
    if (!balanceInput.value || Number(balanceInput.value) <= 0) {
      statusLine.textContent = 'Enter a balance (₹) to simulate a week/month.';
      statusLine.classList.add('error');
      return;
    }
    generateBtn.disabled = true;
    statusLine.classList.remove('error');
    statusLine.innerHTML = `<span class="spinner"></span> Simulating the ${period} — this runs one report per trading day, please wait...`;

    try {
      const res = await fetch('/api/eod-report/run-range?' + buildQuery() + '&period=' + period);
      const data = await res.json();
      if (!data.success) throw new Error(data.message || 'Failed to generate range report');

      renderRange(data.period, data.result);
      statusLine.classList.remove('error');
      statusLine.textContent = `Simulation ready for ${data.result.startDate} \u2192 ${data.result.endDate}.`;
    } catch (err) {
      statusLine.classList.add('error');
      statusLine.textContent = 'Error: ' + err.message;
    } finally {
      generateBtn.disabled = false;
    }
    return;
  }

  generateBtn.disabled = true;
  statusLine.classList.remove('error');
  statusLine.innerHTML = '<span class="spinner"></span> Fetching signals and Fyers candle data...';

  try {
    const res = await fetch('/api/eod-report/run?' + buildQuery());
    const data = await res.json();
    if (!data.success) throw new Error(data.message || 'Failed to generate report');

    render(data.report);    statusLine.classList.remove('error');
    statusLine.textContent = data.report.noSignals
      ? `No signals found for ${data.report.dateStr}.`
      : `Report ready for ${data.report.dateStr}.`;

    // Wire up the AI chat panel to this freshly generated report. A new
    // report resets the conversation, since old answers referred to
    // whatever filters/date were active before.
    lastReport = data.report;
    resetChatPanel('day', {
      hasData: !data.report.noSignals,
      emptyText: data.report.noSignals
        ? 'No signals for this date, so there\'s nothing to ask about yet.'
        : 'Ask a question about this report below.',
      placeholder: 'e.g. Which BUY signal had the best profit%?'
    });
  } catch (err) {
    statusLine.classList.add('error');
    statusLine.textContent = 'Error: ' + err.message;
  } finally {
    generateBtn.disabled = false;
  }
}

generateBtn.addEventListener('click', generateReport);

document.getElementById('brokeragePerTrade').addEventListener('input', () => {
  // Re-render instantly from whatever's already loaded — no need to
  // re-fetch just because the brokerage figure changed. Works for both
  // the single-day view and the week/month/custom range view.
  if (!rangeView.classList.contains('hidden') && lastRangeState) {
    renderRange(lastRangeState.period, lastRangeState.result);
  } else if (lastReport) {
    renderSummary(lastReport);
  }
});
downloadBtn.addEventListener('click', () => {
  if (periodSelect.value !== 'day') {
    statusLine.textContent = 'Download currently only supports Single day — switch the period back to Single day to download.';
    statusLine.classList.add('error');
    return;
  }
  if (!dateInput.value) {
    statusLine.textContent = 'Please pick a date first.';
    statusLine.classList.add('error');
    return;
  }
  const format = downloadFormatSelect.value;
  window.location.href = '/api/eod-report/download?' + buildQuery() + '&format=' + format;
});

// ---- AI chat panel ----

function appendChatMessage(role, text, extraClass) {
  chatEmpty.classList.add('hidden');
  const div = document.createElement('div');
  div.className = `chat-msg ${role}${extraClass ? ' ' + extraClass : ''}`;
  div.textContent = text;
  chatLog.appendChild(div);
  chatLog.scrollTop = chatLog.scrollHeight;
  return div;
}

async function sendChatQuestion(question) {
  const hasData = chatMode === 'day' ? Boolean(lastReport) : Boolean(lastRangeState);
  if (!hasData) return;
  const trimmed = question.trim();
  if (!trimmed) return;

  appendChatMessage('user', trimmed);
  chatHistory.push({ role: 'user', content: trimmed });

  const pendingEl = appendChatMessage('assistant', 'Thinking...', 'pending');
  chatInput.value = '';
  chatInput.disabled = true;
  chatSendBtn.disabled = true;

  try {
    const payload = chatMode === 'range'
      ? { range: lastRangeState.result, period: lastRangeState.period, question: trimmed, history: chatHistory }
      : { report: lastReport, question: trimmed, history: chatHistory };

    const res = await fetch('/api/eod-report/chat', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    const data = await res.json();
    if (!data.success) throw new Error(data.message || 'Failed to get an answer');

    pendingEl.textContent = data.answer;
    pendingEl.classList.remove('pending');
    chatHistory.push({ role: 'assistant', content: data.answer });
  } catch (err) {
    pendingEl.textContent = 'Error: ' + err.message;
    pendingEl.classList.remove('pending');
    pendingEl.classList.add('error');
    chatHistory.pop(); // don't keep the failed turn's user question dangling with no answer context
  } finally {
    const stillHasData = chatMode === 'day' ? Boolean(lastReport) && !lastReport.noSignals : Boolean(lastRangeState) && lastRangeState.result.tradingDaysCount > 0;
    chatInput.disabled = !stillHasData;
    chatSendBtn.disabled = !stillHasData;
    chatInput.focus();
  }
}

chatSendBtn.addEventListener('click', () => sendChatQuestion(chatInput.value));
chatInput.addEventListener('keydown', (e) => {
  if (e.key === 'Enter') sendChatQuestion(chatInput.value);
});
chatSuggestions.addEventListener('click', (e) => {
  const btn = e.target.closest('.chat-suggestion-btn');
  if (!btn) return;
  sendChatQuestion(btn.dataset.q);
});
</script>

</body>
